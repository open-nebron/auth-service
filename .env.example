# Server Configuration
PORT=4001
NODE_ENV=development
LOG_LEVEL=info

# Database & Cache
MONGO_URL=mongodb://mongo:27017/zenuxs_auth
REDIS_URL=redis://redis:6379

# JWT Asymmetric Keypair Configuration
# In development, missing keys are automatically generated and saved to these paths.
# In production, keys must exist or boot will fail fast.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_CURRENT_KID=dev-1

# Token Lifetimes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Security & CORS (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
